<Project>
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>CS1998</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../../../Tsinswreng.CsTypeAlias/TypeAlias.cs"/>
	</ItemGroup>

	<ItemGroup>
		<!-- <ProjectReference Include="../../../Tsinswreng.CsTreeTest/proj/Tsinswreng.CsTreeTest/Tsinswreng.CsTreeTest.csproj" /> -->
		<PackageReference Include="Tsinswreng.CsTreeTest" Version="0.1.1-alpha" />
		<PackageReference Include="Tsinswreng.CsCore" Version="0.0.1-alpha" />
		<PackageReference Include="Tsinswreng.CsTools" Version="0.0.1-alpha" />
		<PackageReference Include="Tsinswreng.CsCfg" Version="0.0.1-alpha" />
		<ProjectReference Include="../../../Tsinswreng.CsSql/proj/Tsinswreng.CsSql/Tsinswreng.CsSql.csproj" />
		<!-- <ProjectReference Include="../../../Tsinswreng.AvlnTools/proj/Tsinswreng.AvlnTools/Tsinswreng.AvlnTools.csproj" /> -->
		<!-- <ProjectReference Include="../../../Tsinswreng.CsCore/proj/Tsinswreng.CsCore/Tsinswreng.CsCore.csproj" /> -->
		<!-- <ProjectReference Include="../../../Tsinswreng.CsTools/proj/Tsinswreng.CsTools/Tsinswreng.CsTools.csproj" /> -->
		<!-- <ProjectReference Include="../../../Tsinswreng.CsCfg/proj/Tsinswreng.CsCfg/Tsinswreng.CsCfg.csproj" /> -->
		<ProjectReference Include="../../../Ngaq.Core/Ngaq.Core.csproj" />
		<ProjectReference Include="../../../Ngaq.Backend/Ngaq.Backend.csproj" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10"/>
	</ItemGroup>
</Project>
